# ============================================
# Vertamart — configuración de entorno (demo)
# Copia este archivo como `.env` y ajusta los valores.
# ============================================

# Fuente de datos del catálogo:
#   mock  → datos locales (por defecto, la demo funciona sin backend)
#   api   → API real definida en VITE_API_URL
# Si defines VITE_API_URL, la app usa la API automáticamente
# aunque VITE_DATA_SOURCE no esté seteada.
VITE_DATA_SOURCE=mock

# URL base de la API (ej: https://api.tudominio.com/api)
# En desarrollo, /api/* se proxya al backend local (server/) en :4000.
# Para producción apunta VITE_API_URL al backend real y asegúrate de que
# exponga los mismos endpoints /api/auth/* documentados en docs/API.md.
# VITE_API_URL=

# Ejemplo producción con Cloudflare (ver docs/DEPLOY_CLOUDFLARE.md):
# VITE_API_URL=https://vertamart-api.<tu-subdominio>.workers.dev/api

# Token opcional para endpoints protegidos (Authorization: Bearer <token>)
# VITE_API_TOKEN=

# Proveedor de pagos del checkout:
#   mock    → pago simulado (por defecto, la demo funciona sin backend)
#   stripe  → integrar Stripe (requiere backend con la secret key)
#   webpay  → integrar Transbank Webpay (requiere credenciales de comercio)
# VITE_PAYMENT_PROVIDER=mock

# PayPal se configura en el Worker, nunca en el frontend:
# npx wrangler secret put PAYPAL_CLIENT_ID
# npx wrangler secret put PAYPAL_CLIENT_SECRET
# npx wrangler secret put PAYPAL_ENV  # sandbox o live
