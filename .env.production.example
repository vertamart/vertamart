# URL HTTPS de la API pública (Cloudflare Worker)
VITE_API_URL=https://vertamart-api.rcbegararoblox.workers.dev/api

# URLs públicas de descarga de las apps instalables.
# Opción recomendada (gratis y sin límite de tamaño): GitHub Releases, con el patrón
#   https://github.com/<usuario>/<repo>/releases/latest/download/<archivo>
# Define la URL exacta de cada instalador cuando tengas el repositorio publicado.
VITE_DESKTOP_DOWNLOAD_URL=https://github.com/<usuario>/<repo>/releases/latest/download/Vertamart-Setup-v1.1.0.exe
VITE_ANDROID_DOWNLOAD_URL=https://github.com/<usuario>/<repo>/releases/latest/download/Vertamart-v1.1.0.apk

# URL usada por la app de escritorio/Android para cargar la web pública
VERTAMART_PUBLIC_URL=https://vertamart.pages.dev